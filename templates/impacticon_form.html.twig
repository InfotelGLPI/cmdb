{# Rows of the impact icon form (ImpactIcon::showForm()), inside the table opened by
   showFormHeader(). The criteria row follows the item type
   (public/scripts/impacticon_form.js, data-cmdb-impacticon). #}
<tr class="tab_bg_1">
    <td>{{ __('Item type') }}</td>
    <td data-cmdb-impacticon data-url="{{ criteria_url }}" data-id="{{ id }}">{{ type_dropdown|raw }}</td>
</tr>
<tr class="tab_bg_1" id="criteria_row"></tr>
{% if icon_url is not empty %}
    <tr class="tab_bg_1">
        <td>{{ __('Current icon', 'cmdb') }}</td>
        <td><img src="{{ icon_url }}" style="height: 50px; width: 50px" alt=""></td>
    </tr>
{% endif %}
<tr class="tab_bg_1">
    <td>{{ __('Icon file', 'cmdb') }}</td>
    <td>{{ file_input|raw }}</td>
</tr>