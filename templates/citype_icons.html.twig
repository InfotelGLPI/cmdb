{# One panel per type, holding the icon already stored for it and the input that replaces
 # it. The panels are drawn by the accordion of Bootstrap, which the core ships and binds
 # through a delegated handler on [data-bs-toggle="collapse"]: no script of the plugin has
 # to run, and the markup works the same whether it arrives with the page or inside an AJAX
 # response. What it replaces did neither -- the <h3>/<div> pairs were handed to a jQuery UI
 # accordion that is shipped by neither the core nor this plugin, by an inline accordion()
 # call emitted before ADD_JAVASCRIPT had declared the function in the footer. #}
<div class="accordion" id="{{ dom_id }}">
    {% for panel in panels %}
        {% set collapse_id = dom_id ~ '-' ~ loop.index0 %}
        <div class="accordion-item">
            <h3 class="accordion-header">
                <button class="accordion-button collapsed" type="button"
                        data-bs-toggle="collapse" data-bs-target="#{{ collapse_id }}"
                        aria-expanded="false" aria-controls="{{ collapse_id }}">
                    {{ panel.name }}
                </button>
            </h3>
            <div id="{{ collapse_id }}" class="accordion-collapse collapse"
                 data-bs-parent="#{{ dom_id }}">
                <div class="accordion-body">
                    {% if panel.icon_url is not empty %}
                        <img width="32" height="32" src="{{ panel.icon_url }}"
                             alt="{{ panel.name }}" class="me-2">
                    {% endif %}
                    <input class="form-control" type="file" name="{{ panel.input_name }}">
                </div>
            </div>
        </div>
    {% endfor %}
</div>
