{# Criticity of a business criticity (Criticity::showForm()): color and level #}
<form method="post" action="{{ action }}">
    <div class="spaced">
        <table class="tab_cadre_fixe">
            <tr><th colspan="4">{{ __('Criticity', 'cmdb') }}</th></tr>
            <tr>
                <td>{{ __('Color') }}</td>
                <td>{{ color_field|raw }}</td>
                <td>{{ __('Level') }}</td>
                <td>
                    {% if level_field is null %}
                        {{ __('All levels have already been added', 'cmdb') }}
                    {% else %}
                        {# Core dropdown widget, escaped by the core #}
                        {{ level_field|raw }}
                    {% endif %}
                </td>
            </tr>
            {% if can_add %}
                <tr><th colspan="4">
                    <button type="submit" name="add" class="btn btn-primary">{{ _x('button', 'Add') }}</button>
                </th></tr>
            {% endif %}
            {% if can_update %}
                <tr><th colspan="4">
                    <button type="submit" name="update" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
                </th></tr>
            {% endif %}
            {% if can_purge %}
                <tr><th colspan="4" class="text-end">
                    <button type="submit" name="purge" class="btn btn-primary">{{ _x('button', 'Delete permanently') }}</button>
                </th></tr>
            {% endif %}
        </table>
    </div>
    <input type="hidden" name="id" value="{{ id }}">
    <input type="hidden" name="businesscriticities_id" value="{{ businesscriticities_id }}">
    <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
</form>