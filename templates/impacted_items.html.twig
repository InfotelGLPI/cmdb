{# Items impacted by the ticket, one panel per criticity. The panels are drawn by the
 # accordion of Bootstrap, bound by the core through a delegated handler on
 # [data-bs-toggle="collapse"], so they open inside the response of the tab this is
 # rendered in. The jQuery UI accordion they replace was never loaded: neither the core nor
 # this plugin ships jQuery UI. All panels start open, as the accordion('...', 1) call did.
 # No data-bs-parent either, for the same reason: the panels are independent here. #}
<table class="tab_cadre_fixe">
    <tr class="headerRow">
        <th>{{ __('Impacted items', 'cmdb') }}</th>
    </tr>
    <tr>
        <td>
            <div class="accordion" id="{{ dom_id }}">
                {% for panel in panels %}
                    {% set collapse_id = dom_id ~ '-' ~ loop.index0 %}
                    <div class="accordion-item">
                        <h3 class="accordion-header" style="background: {{ panel.color|e('html_attr') }}">
                            <button class="accordion-button bg-transparent" type="button"
                                    data-bs-toggle="collapse" data-bs-target="#{{ collapse_id }}"
                                    aria-expanded="true" aria-controls="{{ collapse_id }}">
                                <b>{{ criticity_label }} : {{ panel.name }}</b>
                            </button>
                        </h3>
                        <div id="{{ collapse_id }}" class="accordion-collapse collapse show">
                            <div class="accordion-body">
                                <table class="tab_cadre_fixe">
                                    <tr class="headerRow">
                                        <th>{{ __('Impacted items', 'cmdb') }}</th>
                                        <th width="100">{{ __('Proximity', 'cmdb') }}</th>
                                    </tr>
                                    {% for item in panel.items %}
                                        <tr>
                                            <td>
                                                <a href="{{ item.url }}" target="_blank">{{ item.label }}</a>
                                            </td>
                                            <td>{{ item.impact }}</td>
                                        </tr>
                                    {% endfor %}
                                </table>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </td>
    </tr>
</table>
