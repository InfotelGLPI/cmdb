{# Rights of the plugin on a profile (Profile::showForm()). The matrices are drawn by the core
   (Profile::displayRightsChoiceMatrix()), only for a central profile. #}
<div class="firstbloc">
    {% if canedit %}
        <form method="post" action="{{ action }}">
            {% for matrix in matrices %}
                {% do profile.displayRightsChoiceMatrix(matrix.rights, {
                    'canedit': true,
                    'default_class': 'tab_bg_2',
                    'title': matrix.title,
                }) %}
            {% endfor %}

            <table class="tab_cadre_fixehov">
                <tr class="tab_bg_1"><th colspan="4">{{ __('Helpdesk') }}</th></tr>
                <tr class="tab_bg_2">
                    <td width="20%">{{ __('Associable items to a ticket') }}</td>
                    <td colspan="5">
                        {{ call('Html::getCheckbox', [{
                            'name': '_plugin_cmdb_operationprocesses_open_ticket',
                            'checked': open_ticket,
                        }])|raw }}
                    </td>
                </tr>
            </table>

            <div class="center">
                <input type="hidden" name="id" value="{{ id }}">
                <button type="submit" name="update" class="btn btn-primary">{{ _x('button', 'Save') }}</button>
            </div>
            <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
        </form>
    {% endif %}
</div>
