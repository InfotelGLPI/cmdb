{# Criticity of an asset, added to its form (Criticity::addFieldCriticity(), post_item_form
   hook) or refreshed alone (ajax/criticity_values.php: with_header false). The dropdown is a
   core widget, escaped by the core. #}
{% set row %}
    <tr class="tab_bg_1" id="plugin_cmdb_tr">
        <td>{{ label }}</td>
        <td><span style="width:80%">{{ dropdown|raw }}</span></td>
        {% if pad %}
            <td colspan="2"></td>
        {% endif %}
    </tr>
{% endset %}
{% if with_header %}
    <table class="tab_cadre_fixe">
        <tr class="tab_bg_1"><th colspan="{{ colspan }}">{{ title }}</th></tr>
        {{ row }}
    </table>
{% else %}
    {{ row }}
{% endif %}