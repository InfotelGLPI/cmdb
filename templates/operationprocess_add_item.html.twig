{# Add form of the items of a service (OperationProcess_Item::showForOperationProcess()) and of
   the services of an item (OperationProcess_Item::showForItem()). The selector is a core
   widget, escaped by the core. #}
<div class="firstbloc">
    <form method="post" action="{{ action }}">
        <table class="tab_cadre_fixe">
            {% if title is not empty %}
                <tr class="tab_bg_2"><th colspan="2">{{ title }}</th></tr>
            {% endif %}
            <tr class="tab_bg_1">
                <td class="center">
                    {% for name, value in hidden %}
                        <input type="hidden" name="{{ name }}" value="{{ value }}">
                    {% endfor %}
                    {{ selector|raw }}
                </td>
                <td class="center" width="20%">
                    <button type="submit" name="additem" class="btn btn-primary">{{ button }}</button>
                </td>
            </tr>
        </table>
        <input type="hidden" name="_glpi_csrf_token" value="{{ csrf_token() }}">
    </form>
</div>