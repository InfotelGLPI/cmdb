{# Item type of an impact tooltip (ImpactInfo::showForm()): a selector for a new tooltip, the
   type name afterwards. The field list (#fieldsForm) is loaded by
   public/scripts/impactinfo_fields.js from data-cmdb-impactinfo. #}
<tr class="tab_bg_1">
    <td>{{ __('Item type') }}</td>
    <td data-cmdb-impactinfo
        data-url="{{ fields_url }}"
        data-id="{{ id }}"
        data-itemtype="{{ itemtype }}">
        {% if types is not null %}
            {{ call('Dropdown::showFromArray', ['itemtype', types, {
                value: itemtype,
                required: true,
                display_emptychoice: true,
                display: false,
            }])|raw }}
        {% else %}
            {{ typename }}
        {% endif %}
    </td>
</tr>
<tr class="tab_bg_1" id="fieldsForm"></tr>