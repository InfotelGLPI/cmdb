{# Rows of the CI form (CI::showForm()), inside the table opened by showFormHeader(). The CI type
   selector reloads the custom fields (public/js/show_fields.js, data-cmdb-ci-type). #}
<tr class="tab_bg_1">
    <td>{{ __('Name') }}</td>
    <td><input type="text" class="form-control" name="name" value="{{ name }}" size="40"></td>
</tr>
<tr class="tab_bg_1 fieldCI">
    <td>{{ type_label }}</td>
    <td data-cmdb-ci-type="{{ id }}">{{ type_dropdown|raw }}</td>
</tr>
{{ fields_rows|raw }}