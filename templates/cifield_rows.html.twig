{# Custom fields of a CI (CiFields::setFieldByType(), CI form and ajax/change_field.php): one
   row per field, the input matching its type. The widgets are core helpers, escaped by the
   core. The rows carry the class "field", removed by changeField() of public/js/show_fields.js
   when the CI type changes. #}
{% for field in fields %}
    <tr class="field tab_bg_1">
        <td>{{ field.label }}</td>
        <td>{{ field.input|raw }}</td>
    </tr>
{% endfor %}