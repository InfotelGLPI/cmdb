{# One field of the impact tooltip; public/scripts/impactinfo_fields.js builds the same markup
   for a newly added field (keep both in sync). #}
<div class="d-flex align-items-center justify-content-between border rounded m-1 p-2" data-cmdb-field="{{ field_id }}">
    <span>
        <label>{{ __('Order', 'cmdb') }}</label>
        <input type="number" name="{{ key }}-fields[{{ field_id }}][order]" value="{{ order }}" style="max-width: 5rem" class="ms-2">
    </span>
    <strong>{{ label }}</strong>
    <input type="hidden" name="{{ key }}-fields[{{ field_id }}][type]" value="{{ key }}">
    <input type="hidden" name="{{ key }}-fields[{{ field_id }}][field_id]" value="{{ field_id }}">
    <i class="ti ti-x mx-2 fs-2" aria-hidden="true" role="button" title="{{ __('Delete') }}" data-cmdb-field-remove></i>
</div>