{# One custom field of a CI type (CIType::showForm(), ajax/reset_fields_citypes.php). An
   existing field posts nameField[id]/typeField[id] and is flagged deleted when removed; a new
   one posts nameNewField[]/typeNewField[]. The trash icon is handled by
   public/js/function_form_CIType.js (data-cmdb-delete-field). #}
<tr class="tab_bg_2 center{{ is_new ? '' : ' field' }}" id="{{ row_id }}">
    <td>
        <input type="text" class="form-control" name="{{ is_new ? 'nameNewField[]' : 'nameField[' ~ row_id ~ ']' }}"
               value="{{ name }}" size="40" required>
    </td>
    <td>
        {# Core dropdown widget, escaped by the core #}
        {{ type_dropdown|raw }}
    </td>
    <td>
        <i class="fa-2x ti ti-trash pointer" role="button" title="{{ __('Delete') }}"
           data-cmdb-delete-field="{{ row_id }}"{% if not is_new %} data-cmdb-deleted="1"{% endif %}></i>
    </td>
</tr>