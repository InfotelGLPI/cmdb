{# Item configuration menu (Cmdb::displayMenu()): one tile per CI type, three per row #}
{% if tiles is not empty %}
    <div class="center">
        <table class="tab_cadre" width="30%">
            <tr><th colspan="3" class="center">{{ __('Display Item Configuration', 'cmdb') }}</th></tr>
            {% for row in tiles|batch(3) %}
                <tr class="tab_bg_1">
                    {% for tile in row %}
                        <td class="center b">
                            <a href="{{ tile.link }}">
                                {% if tile.icon_url is not empty %}
                                    <img width="64" height="64" src="{{ tile.icon_url }}" alt="">
                                {% else %}
                                    <i class="ti ti-adjustments"></i>
                                {% endif %}
                                <br>
                                {{ tile.name }}
                            </a>
                        </td>
                    {% endfor %}
                </tr>
            {% endfor %}
        </table>
    </div>
{% endif %}